#define IDI_COATROOM 101

IDI_COATROOM ICON "coatroom.ico"
1 24 "coatroom.manifest"

1 VERSIONINFO
FILEVERSION     1,2,0,0
PRODUCTVERSION  1,2,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Coatroom Studio"
            VALUE "FileDescription",  "Coatroom - 3D Automotive Livery & Beauty Render Studio"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "Coatroom"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Coatroom Studio"
            VALUE "OriginalFilename", "Coatroom.exe"
            VALUE "ProductName",      "Coatroom"
            VALUE "ProductVersion",   "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
